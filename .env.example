##############################################################################
# SwissHub – Umgebungskonfiguration
#
# Diese Datei als Vorlage kopieren:  cp .env.example .env
# Niemals echte Zugangsdaten committen. Die .env ist über .gitignore
# ausgeschlossen.
##############################################################################

# --- Grundlagen --------------------------------------------------------------

NODE_ENV=production

# Öffentliche Adresse der Website – ohne abschliessenden Schrägstrich.
# Wird für Canonicals, Sitemap, Open Graph und den OAuth-Rückruf verwendet.
APP_URL=https://swisshub.gg

# Zufälliges Geheimnis für Sitzungs-Token und Pseudonymisierung.
# Erzeugen mit:  openssl rand -hex 32
# Ein Wechsel meldet alle angemeldeten Personen ab.
SESSION_SECRET=

# Gültigkeitsdauer einer Admin-Sitzung in Stunden (1–720).
SESSION_TTL_HOURS=12

# --- Datenbank ---------------------------------------------------------------

# Wird im Docker-Compose-Betrieb automatisch aus POSTGRES_* zusammengesetzt.
# Für den lokalen Betrieb hier vollständig angeben.
DATABASE_URL=postgresql://swisshub:passwort@localhost:5432/swisshub?schema=public

# Nur für docker-compose: Zugangsdaten des Datenbankcontainers.
POSTGRES_DB=swisshub
POSTGRES_USER=swisshub
POSTGRES_PASSWORD=

# Optional: eigene Datenbank für die Integrationstests (npm test).
# DATABASE_URL_TEST=postgresql://swisshub:passwort@localhost:5432/swisshub_test?schema=public

# --- Discord OAuth2 (Admin-Anmeldung) ----------------------------------------
#
# Einrichtung siehe docs/oauth.md.
# Redirect-URI im Discord Developer Portal eintragen:
#   ${APP_URL}/admin/login/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ID des SwissHub-Discord-Servers. Nur Mitglieder dieses Servers erhalten Zugang.
DISCORD_GUILD_ID=

# Discord-Rollen, die den Zugang zum Dashboard erlauben (IDs, kommagetrennt).
DISCORD_ADMIN_ROLE_IDS=

# Einzelne Discord-Benutzer-IDs, die unabhängig von Rollen Zugang erhalten.
DISCORD_ALLOWED_USER_IDS=

# Diese Discord-IDs erhalten beim ersten Login automatisch Superadmin-Rechte.
# Nach der Ersteinrichtung leeren.
DISCORD_BOOTSTRAP_SUPERADMIN_IDS=

# Optional: Bot-Token als Rückfallweg für die Mitgliedschaftsprüfung.
# Der Bot muss Mitglied des Servers sein und das Recht besitzen, Mitglieder zu lesen.
DISCORD_BOT_TOKEN=

# --- E-Mail-Versand ----------------------------------------------------------
#
# Ohne diese Angaben werden Nachrichten gespeichert, aber nicht versendet.
# Zugangsdaten stehen bewusst nur hier und nie in der Datenbank.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

MAIL_FROM_NAME=SwissHub
MAIL_FROM_ADDRESS=noreply@swisshub.gg

# --- Medien ------------------------------------------------------------------

# Verzeichnis für hochgeladene Dateien. Liegt ausserhalb des Web-Verzeichnisses
# und wird im Container als Volume eingebunden.
STORAGE_DIR=/data/storage

# Maximale Uploadgrösse je Datei in MB (1–100).
MAX_UPLOAD_MB=10

# --- Optionaler CAPTCHA-Schutz (Cloudflare Turnstile) ------------------------
#
# Beide Werte setzen und die Funktion anschliessend im Dashboard aktivieren.

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Betrieb -----------------------------------------------------------------

# Hintergrundlauf für terminierte Veröffentlichungen, E-Mail-Warteschlange und
# Aufbewahrungsfristen. Bei mehreren Instanzen nur auf einer aktivieren.
ENABLE_BACKGROUND_JOBS=true

# Anonyme, aggregierte Nutzungsstatistik ohne Cookies und ohne externe Dienste.
METRICS_ENABLED=true

# Auf true lassen, wenn die Anwendung hinter einem Reverse Proxy läuft
# (Nginx oder Apache, X-Forwarded-For).
TRUST_PROXY=true

# Weitere öffentliche Domains, unter denen die Website erreichbar ist –
# kommagetrennt, zusätzlich zu APP_URL. Sie werden als erlaubte Herkunft für
# Server Actions eingetragen. Interne Adressen wie 127.0.0.1:3001 gehören hier
# ausdrücklich NICHT hinein; der Proxy muss stattdessen den öffentlichen Host
# durchreichen (Apache: ProxyPreserveHost On, Nginx: proxy_set_header Host $host).
#
# Eine abgelöste Domain gehört ebenfalls nicht hierher: Sie wird im Proxy
# dauerhaft auf APP_URL weitergeleitet und erreicht die Anwendung gar nicht.
# ADDITIONAL_ORIGINS=www.swisshub.gg
